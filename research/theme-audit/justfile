# Research-only pipeline. Dependencies execute in the written order.
# https://just.systems/man/en/dependencies.html

default:
    @just --list

sync:
    uv sync --frozen

measure: sync
    uv run --frozen python measure.py

experiments: sync
    uv run --frozen python experiments.py

reports: foundations
    uv run --frozen python build_reports.py

test: sync
    uv run --frozen python -m pytest -q

foundations: sync
    uv run --frozen python foundations.py

check: measure experiments foundations reports contract test

specimens: sync
    uv run --frozen python build_specimens.py

serve: reports
    @echo "Font specimens require repository-root serving: http://127.0.0.1:8774/research/theme-audit/01-design-language.html"
    uv run --frozen python -m http.server 8774 --bind 127.0.0.1 --directory ../..

contract: foundations
    uv run --frozen python build_contract.py

contract-test: contract
    uv run --frozen python -m pytest tests/test_contract.py -q
