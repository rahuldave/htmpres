axes.labelsize: 12.0
xtick.labelsize: 12.0
ytick.labelsize: 12.0
legend.fontsize: 12.0
lines.linewidth: 1.25
axes.spines.top: False
axes.spines.right: False
pdf.fonttype: 42
svg.fonttype: path
axes.unicode_minus: False
