grid.color: 53606c
font.size: 14.4
axes.titlesize: 14.4
axes.labelsize: 14.4
xtick.labelsize: 14.4
ytick.labelsize: 14.4
legend.fontsize: 14.4
lines.linewidth: 2.25
axes.spines.top: False
axes.spines.right: False
pdf.fonttype: 42
svg.fonttype: path
axes.unicode_minus: False
