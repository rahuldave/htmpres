# Experimental plot chrome; choose data palette explicitly.
figure.facecolor: 222222
axes.facecolor: 222222
text.color: eeeeee
axes.labelcolor: eeeeee
xtick.color: eeeeee
ytick.color: eeeeee
axes.edgecolor: bdc4cb
grid.color: 53606c
font.family: Lato
font.size: 12
axes.titlesize: 14
axes.spines.top: False
axes.spines.right: False
axes.grid: False
savefig.facecolor: 222222
savefig.transparent: False
lines.linewidth: 2.2
