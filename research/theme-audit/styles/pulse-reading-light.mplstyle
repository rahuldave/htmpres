# Experimental plot chrome; choose data palette explicitly.
figure.facecolor: ffffff
axes.facecolor: ffffff
text.color: 444444
axes.labelcolor: 444444
xtick.color: 444444
ytick.color: 444444
axes.edgecolor: 62586c
grid.color: c9c2d1
font.family: DejaVu Sans
font.size: 12
axes.titlesize: 14
axes.spines.top: False
axes.spines.right: False
axes.grid: False
savefig.facecolor: ffffff
savefig.transparent: False
lines.linewidth: 2.2
