# Experimental plot chrome; choose data palette explicitly.
figure.facecolor: 182032
axes.facecolor: 182032
text.color: e8edf2
axes.labelcolor: e8edf2
xtick.color: e8edf2
ytick.color: e8edf2
axes.edgecolor: bec4cc
grid.color: 4e5564
font.family: Inter
font.size: 12
axes.titlesize: 14
axes.spines.top: False
axes.spines.right: False
axes.grid: False
savefig.facecolor: 182032
savefig.transparent: False
lines.linewidth: 2.2
