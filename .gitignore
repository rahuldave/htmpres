# macOS/local editor noise
.DS_Store
*.swp
*.swo

# Dependencies and local caches
node_modules/
.quarto/
.cache/
.gest/
*.log

# Rendered deck outputs are reproducible from QMD.
decks/*/index.html
decks/*/presenter.html
decks/*/index_files/

# Proprietary/local source material. Do not publish these decks or snapshots.
source_presentations/
decks/first/
decks/firstallincluded/
decks/technical/
decks/executive/
decks/styles/

# Keep tutorial sources and shared runtime scripts trackable.
!decks/tutorial/
!decks/tutorial/index.qmd
!decks/tutorial/source.css
!decks/tutorial/assets/
!decks/tutorial/assets/**
!decks/scripts/
!decks/scripts/**

# Reproducible SmallDocs site, comparison variants and staged theme fonts.
docs/_site/
docs/_generated/
docs/_extensions/nocturne/fonts/
decks/*/assets/htmpres-themes/
decks/*/assets/htmpres-math/

# Independent package scaffold build outputs and local Python caches.
/.build/packages/
/packages/python/dist/
/packages/python/build/
/packages/python/.venv/
/packages/python/src/*.egg-info/
/packages/python/**/__pycache__/
/scripts/__pycache__/
/tests/__pycache__/
/integration_tests/__pycache__/

# Build-only neutral specification tools.
/packages/spec/.venv/
/packages/spec/tools/__pycache__/
