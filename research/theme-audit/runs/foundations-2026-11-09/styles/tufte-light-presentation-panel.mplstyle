# Furniture only; explicit font registration and data encodings required.
figure.facecolor: f8f8ee
axes.facecolor: f8f8ee
savefig.facecolor: f8f8ee
savefig.transparent: False
text.color: 111111
axes.labelcolor: 111111
xtick.color: 111111
ytick.color: 111111
axes.edgecolor: 90908a
grid.color: d6d6cc
font.size: 12.0
