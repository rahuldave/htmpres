# Experimental plot chrome; choose data palette explicitly.
figure.facecolor: f8f4eb
axes.facecolor: f8f4eb
text.color: 25372d
axes.labelcolor: 25372d
xtick.color: 25372d
ytick.color: 25372d
axes.edgecolor: 5f6b62
grid.color: d4d6c7
font.family: DM Sans
font.size: 12
axes.titlesize: 14
axes.spines.top: False
axes.spines.right: False
axes.grid: False
savefig.facecolor: f8f4eb
savefig.transparent: False
lines.linewidth: 2.2
